{
  "name": "beni",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run build && bun src/backend/server.ts",
    "test": "bun run build && bun test src/backend/server.test.ts src/backend/manual-tools.test.ts src/backend/store/index.test.ts src/backend/project-events.test.ts src/backend/chat.test.ts src/backend/claude.test.ts src/backend/agents/*.test.ts src/backend/terminal.test.ts && bun run test:ui",
    "build:css": "tailwindcss -i ./src/frontend/tailwind.css -o ./dist/frontend/generated.css --minify",
    "typecheck": "tsc -p tsconfig.json",
    "build:ui": "bun run typecheck && vite build",
    "build": "bun run build:ui && bun run build:css",
    "test:ui": "node --conditions=browser ./node_modules/vitest/vitest.mjs run --config vitest.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.3",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/cli": "^4.3.5",
    "@types/bun": "1.4.4",
    "daisyui": "^5.7.50",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  }
}
