{
  "name": "beni",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run build && bun server.ts",
    "test": "bun run build && bun test server.test.ts store/index.test.ts && bun run test:ui",
    "build:css": "tailwindcss -i ./ui/tailwind.css -o ./ui/generated.css --minify",
    "typecheck:ui": "tsc -p tsconfig.ui.json",
    "build:ui": "bun run typecheck:ui && vite build",
    "build": "bun run build:css && bun run build:ui",
    "test:ui": "bun --conditions=browser ./node_modules/vitest/vitest.mjs run --config vitest.config.ts"
  },
  "dependencies": {
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/cli": "^4.3.4",
    "daisyui": "^5.7.50",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  }
}
