{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"], "jsx": "preserve", "jsxImportSource": "solid-js",
    "strict": true, "noEmit": true, "skipLibCheck": true, "types": ["bun"]
  },
  "include": ["src/shared/**/*.ts", "src/backend/**/*.ts", "src/frontend/**/*.ts", "src/frontend/**/*.tsx", "scripts/**/*.ts"]
}
